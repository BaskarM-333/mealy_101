module mealy_101(input clk,rst,in,output reg out);
  parameter s0=2'b00;
  parameter s1=2'b01;
  parameter s2=2'b10;
  reg [1:0]present_state,next_state;
  always@(posedge clk or posedge rst)begin
    if(rst)
      present_state<=s0;
  else
    present_state<=next_state;
  end
  always@(*)begin
    out=0;
    case(present_state)
      s0:begin
      if(in==1)
        next_state=s1;
      else
        next_state=s0;
      end
      s1:begin
        if(in==0)
          next_state=s2;
        else
          next_state=s1;
      end
      s2:begin
        if(in==1)begin
          next_state=s0;
          out=1;
        end
        else begin
          next_state=s1;
          out=0;
        end
      end
      default:begin
        next_state=s0;
        out=0;
      end
    endcase
  end
endmodule






        
